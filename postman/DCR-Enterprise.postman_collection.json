{
  "info": {
    "name": "DCR Enterprise - Open Finance Brasil",
    "description": "Coleção completa de testes para Dynamic Client Registration (DCR) conforme FAPI-BR, RFC 7591/7592",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "1. Registro com Sucesso",
      "item": [
        {
          "name": "POST /register - Registro Completo (Sucesso)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Gerar SSA válido (mock - em produção viria do Diretório)",
                  "const jti = pm.variables.replaceIn('{{$guid}}');",
                  "pm.environment.set('ssa_jti', jti);",
                  "",
                  "// Simular timestamp",
                  "const now = Math.floor(Date.now() / 1000);",
                  "pm.environment.set('ssa_iat', now);",
                  "pm.environment.set('ssa_exp', now + 3600);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code é 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response possui client_id', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('client_id');",
                  "    pm.environment.set('client_id', jsonData.client_id);",
                  "});",
                  "",
                  "pm.test('Response possui registration_access_token', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('registration_access_token');",
                  "    pm.environment.set('registration_access_token', jsonData.registration_access_token);",
                  "});",
                  "",
                  "pm.test('Response possui registration_client_uri', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('registration_client_uri');",
                  "});",
                  "",
                  "pm.test('token_endpoint_auth_method é private_key_jwt', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.token_endpoint_auth_method).to.eql('private_key_jwt');",
                  "});",
                  "",
                  "pm.test('Tempo de resposta < 1000ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-fapi-interaction-id",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"software_statement\": \"eyJhbGciOiJQUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6IjEyMzQ1In0..mock-signature\",\n  \"jwks_uri\": \"https://cliente.example.com/jwks.json\",\n  \"redirect_uris\": [\n    \"https://cliente.example.com/callback\"\n  ],\n  \"grant_types\": [\n    \"authorization_code\",\n    \"client_credentials\"\n  ],\n  \"response_types\": [\n    \"code\"\n  ],\n  \"token_endpoint_auth_method\": \"private_key_jwt\",\n  \"request_object_signing_alg\": \"PS256\",\n  \"id_token_signed_response_alg\": \"PS256\",\n  \"scope\": \"openid accounts payments\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/openbanking/register",
              "host": ["{{base_url}}"],
              "path": ["openbanking", "register"]
            }
          }
        },
        {
          "name": "GET /register/{client_id} - Obter Configuração",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code é 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response possui client_id correto', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.client_id).to.eql(pm.environment.get('client_id'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{registration_access_token}}"
              },
              {
                "key": "x-fapi-interaction-id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/openbanking/register/{{client_id}}",
              "host": ["{{base_url}}"],
              "path": ["openbanking", "register", "{{client_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Testes de Idempotência",
      "item": [
        {
          "name": "POST /register - Replay com mesmo JTI (Idempotente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code é 201 Created (replay seguro)', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('client_id é o mesmo do registro anterior', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.client_id).to.eql(pm.environment.get('client_id'));",
                  "});",
                  "",
                  "pm.test('Tempo de resposta rápido (cache)', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(300);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"software_statement\": \"eyJhbGciOiJQUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6IjEyMzQ1In0..mock-signature\",\n  \"jwks_uri\": \"https://cliente.example.com/jwks.json\",\n  \"redirect_uris\": [\n    \"https://cliente.example.com/callback\"\n  ],\n  \"grant_types\": [\n    \"authorization_code\",\n    \"client_credentials\"\n  ],\n  \"response_types\": [\n    \"code\"\n  ],\n  \"token_endpoint_auth_method\": \"private_key_jwt\",\n  \"request_object_signing_alg\": \"PS256\",\n  \"id_token_signed_response_alg\": \"PS256\",\n  \"scope\": \"openid accounts payments\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/openbanking/register",
              "host": ["{{base_url}}"],
              "path": ["openbanking", "register"]
            }
          }
        }
      ]
    },
