    {
      "name": "5. Testes de Segurança",
      "item": [
        {
          "name": "POST /register - Sem Certificado mTLS",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code é 401 ou 403', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});",
                  "",
                  "pm.test('Error é invalid_client', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.eql('invalid_client');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"software_statement\": \"valid.ssa.jwt\",\n  \"jwks_uri\": \"https://cliente.example.com/jwks.json\",\n  \"redirect_uris\": [\"https://cliente.example.com/callback\"],\n  \"grant_types\": [\"authorization_code\"],\n  \"response_types\": [\"code\"],\n  \"token_endpoint_auth_method\": \"private_key_jwt\"\n}"
            },
            "url": {
